# third_party/ is NOT redistributed. Every dependency (UniSpeech SV code, WavLM
# checkpoint, w2v2-vad model, etc.) is fetched at setup time by
# scripts/setup_third_party.sh — see README. We keep only the Matcha-TTS submodule
# pointer and an empty placeholder in git.
third_party/*
!third_party/.gitkeep
!third_party/Matcha-TTS
*_pb2_grpc.py
*_pb2.py
*.tar